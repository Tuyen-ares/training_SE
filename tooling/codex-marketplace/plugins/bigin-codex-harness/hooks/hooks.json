{
  "description": "Load the BigIn repository profile and guard destructive tool calls.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/session-start.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\session-start.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading BigIn repository profile"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/pre-tool-guard.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\pre-tool-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking repository guardrails"
          }
        ]
      }
    ]
  }
}

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d
DEFAULT_REGISTER_ROLE_NAME=employee
FRONTEND_ORIGIN=http://localhost:5173

# Public media storage (Firebase Storage / Google Cloud Storage)
# The Firebase project must use the Blaze billing plan before real uploads.
# Keep all Firebase credentials on the backend; never expose them to the frontend.
MEDIA_STORAGE_PROVIDER=firebase-storage
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Put the service-account private key here as one line with escaped newlines.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# The backend derives each public media URL as:
# PUBLIC_MEDIA_BASE_URL + storage_path
PUBLIC_MEDIA_BASE_URL=
MEDIA_STORAGE_PATH_PREFIX=evidence

# Comma-separated image MIME types accepted by the upload endpoint.
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
MEDIA_MAX_IMAGE_SIZE_BYTES=10485760
MEDIA_MAX_IMAGE_COUNT=10
MEDIA_UPLOAD_TIMEOUT_MS=30000
MEDIA_UPLOAD_RETRY_ATTEMPTS=3

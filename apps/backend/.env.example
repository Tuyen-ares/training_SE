DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d
DEFAULT_REGISTER_ROLE_NAME=employee

# AWS S3 credentials are for local development only. Deployments should use
# an IAM role/task role instead; never expose these values to the frontend.
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CloudFront public media URL base; the backend appends its generated object path.
PUBLIC_MEDIA_BASE_URL=

# Upload policy for presigned PUT requests issued by the BigIn API.
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
MEDIA_MAX_IMAGE_SIZE_BYTES=10485760
MEDIA_MAX_IMAGE_COUNT=10
MEDIA_PRESIGNED_PUT_EXPIRES_SECONDS=300

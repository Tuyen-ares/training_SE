DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d
DEFAULT_REGISTER_ROLE_NAME=employee

NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_DB_CONCURRENCY=3
OUTBOX_CONCURRENCY=3
IN_APP_CONCURRENCY=5
EMAIL_CONCURRENCY=10
OUTBOX_BATCH_SIZE=20
DELIVERY_BATCH_SIZE=50
NOTIFICATION_POLL_INTERVAL_MS=2000
NOTIFICATION_LOCK_TIMEOUT_MS=300000
NOTIFICATION_SHUTDOWN_TIMEOUT_MS=30000
APP_PUBLIC_URL=
EMAIL_BRAND_LOGO_URL=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 1) RabbitMQ connection and enabled logical channels
# RabbitMQ is an optional active transport; keep it false until the broker is provisioned.
RABBITMQ_ENABLED=false
# Keep the real backend-only URL in .env; never commit credentials.
# Format: amqps://<user>:<password>@<host>:<port>/<vhost>
RABBITMQ_URL=
RABBITMQ_ENABLED_CHANNELS=IN_APP,EMAIL

# 2) Main delivery exchange
# Publishers use notification.<channel>.<event_type> routing keys.
RABBITMQ_DELIVERY_EXCHANGE=bigin.notification-deliveries
RABBITMQ_DELIVERY_EXCHANGE_TYPE=topic

# 3) IN_APP queue
# IN_APP stays the logical channel when Firebase is added for realtime delivery.
RABBITMQ_IN_APP_QUEUE=bigin.notifications.in-app.v1
RABBITMQ_IN_APP_BINDING_KEY=notification.in_app.#
# Maximum unacknowledged IN_APP messages delivered to one consumer.
RABBITMQ_IN_APP_PREFETCH=20
RABBITMQ_IN_APP_DLQ=bigin.notifications.in-app.dlq.v1
# Assigned by the IN_APP queue when it dead-letters a failed message.
RABBITMQ_IN_APP_DEAD_LETTER_ROUTING_KEY=notification.in_app.failed
# Binds the IN_APP DLQ to the DLX; it must match the routing key above.
RABBITMQ_IN_APP_DLQ_BINDING_KEY=notification.in_app.failed

# 4) EMAIL queue
RABBITMQ_EMAIL_QUEUE=bigin.notifications.email.v1
RABBITMQ_EMAIL_BINDING_KEY=notification.email.#
# Maximum unacknowledged EMAIL messages delivered to one consumer.
RABBITMQ_EMAIL_PREFETCH=5
RABBITMQ_EMAIL_DLQ=bigin.notifications.email.dlq.v1
# Assigned by the EMAIL queue when it dead-letters a failed message.
RABBITMQ_EMAIL_DEAD_LETTER_ROUTING_KEY=notification.email.failed
# Binds the EMAIL DLQ to the DLX; it must match the routing key above.
RABBITMQ_EMAIL_DLQ_BINDING_KEY=notification.email.failed

# 5) Shared dead-letter exchange (DLX)
# Direct routing sends each failed message to the DLQ with an exact matching key.
RABBITMQ_DLX=bigin.dead-letter
RABBITMQ_DLX_TYPE=direct
RABBITMQ_PUBLISH_LEASE_TIMEOUT_MS=30000
RABBITMQ_PUBLISH_HEARTBEAT_INTERVAL_MS=10000
RABBITMQ_CONSUMER_LEASE_TIMEOUT_MS=300000
RABBITMQ_POLL_INTERVAL_MS=2000
RABBITMQ_BATCH_SIZE=50
# AWS credentials are backend-only. Local development and the Render Free MVP
# use an IAM user access key stored as secret env. Prefer an IAM role/task role
# on deployment platforms that support it. Never use root credentials or expose
# these values to the frontend.
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CloudFront public media URL base, without a trailing slash. The backend derives
# the canonical URL by appending "/" and its generated storage_path.
# Distribution ID and OAC ID are infrastructure values, not runtime env vars.
PUBLIC_MEDIA_BASE_URL=

# Upload policy for presigned PUT requests issued by the BigIn API.
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
MEDIA_MAX_IMAGE_SIZE_BYTES=10485760
MEDIA_MAX_EVIDENCE_IMAGE_COUNT=10
MEDIA_PRESIGNED_PUT_EXPIRES_SECONDS=300
